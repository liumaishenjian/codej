<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.liumaishenjian</groupId>
        <artifactId>cc-java</artifactId>
        <version>0.1.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cc-java-cli</artifactId>

    <name>cc-java-cli</name>
    <description>命令行入口、终端交互与依赖装配</description>

    <dependencies>
        <dependency>
            <groupId>io.github.liumaishenjian</groupId>
            <artifactId>cc-java-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.liumaishenjian</groupId>
            <artifactId>cc-java-model-spring-ai</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.liumaishenjian</groupId>
            <artifactId>cc-java-tools-local</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.liumaishenjian</groupId>
            <artifactId>cc-java-tools-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.liumaishenjian</groupId>
            <artifactId>cc-java-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.liumaishenjian</groupId>
            <artifactId>cc-java-protocol</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.liumaishenjian</groupId>
            <artifactId>cc-java-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <!-- Headless 默认不记录 Prompt、端点或 Provider 响应，也避免 SLF4J 无绑定警告污染 stderr。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <archive><manifest><mainClass>io.github.liumaishenjian.ccjava.cli.CcJavaCliMain</mainClass></manifest></archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
