{
  "name": "@cc-java/tui",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.tsx",
    "test": "vitest run --exclude test/real-java-plan-e2e.test.ts --exclude test/installed-plan-e2e.test.ts",
    "test:watch": "vitest --exclude test/real-java-plan-e2e.test.ts --exclude test/installed-plan-e2e.test.ts",
    "test:real-java": "vitest run test/real-java-plan-e2e.test.ts",
    "test:installed-plan": "vitest run test/installed-plan-e2e.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "ink": "7.1.1",
    "marked": "18.0.7",
    "react": "19.2.8",
    "string-width": "8.2.2"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-test-renderer": "19.1.0",
    "ink-testing-library": "4.0.0",
    "react-test-renderer": "19.2.8",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
